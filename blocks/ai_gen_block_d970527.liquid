<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustLayout();
        window.addEventListener('resize', () => this.adjustLayout());
      }

      adjustLayout() {
        const items = this.querySelectorAll('.ai-editorial-item-{{ ai_gen_id }}');
        items.forEach(item => {
          const imageWrapper = item.querySelector('.ai-editorial-image-wrapper-{{ ai_gen_id }}');
          if (imageWrapper) {
            const img = imageWrapper.querySelector('img');
            if (img && img.complete) {
              this.setMinHeight(imageWrapper, img);
            } else if (img) {
              img.addEventListener('load', () => this.setMinHeight(imageWrapper, img));
            }
          }
        });
      }

      setMinHeight(wrapper, img) {
        if (window.innerWidth > 749) {
          const aspectRatio = img.naturalHeight / img.naturalWidth;
          const minHeight = wrapper.offsetWidth * aspectRatio;
          wrapper.style.minHeight = minHeight + 'px';
        }
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Magazine editorial layout",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Grid gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Grid gap on mobile",
      "default": 10
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Minimum height",
      "default": 400
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Content style"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Content padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
