{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    align-items: stretch;
  }

  .ai-editorial-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-editorial-item-{{ ai_gen_id }}--large {
    grid-column: span 8;
    grid-row: span 2;
  }

  .ai-editorial-item-{{ ai_gen_id }}--medium {
    grid-column: span 4;
  }

  .ai-editorial-item-{{ ai_gen_id }}--small {
    grid-column: span 4;
  }

  .ai-editorial-item-{{ ai_gen_id }}--full {
    grid-column: span 12;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    overflow: hidden;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-editorial-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    text-align: {% if block.settings.content_horizontal_alignment == 'flex-start' %}left{% elsif block.settings.content_horizontal_alignment == 'flex-end' %}right{% else %}center{% endif %};
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%
    );
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
    font-weight: 600;
  }

  .ai-editorial-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-editorial-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 20px;
    max-width: 600px;
  }

  .ai-editorial-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 28px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.button_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-editorial-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-editorial-text-only-{{ ai_gen_id }} {
    background-color: {{ block.settings.text_block_background }};
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {% if block.settings.text_alignment == 'left' %}flex-start{% elsif block.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    text-align: {{ block.settings.text_alignment }};
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-editorial-text-only-{{ ai_gen_id }} .ai-editorial-category-{{ ai_gen_id }},
  .ai-editorial-text-only-{{ ai_gen_id }} .ai-editorial-title-{{ ai_gen_id }},
  .ai-editorial-text-only-{{ ai_gen_id }} .ai-editorial-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_block_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(6, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-editorial-item-{{ ai_gen_id }}--large {
      grid-column: span 6;
      grid-row: span 1;
    }

    .ai-editorial-item-{{ ai_gen_id }}--medium,
    .ai-editorial-item-{{ ai_gen_id }}--small {
      grid-column: span 6;
    }

    .ai-editorial-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-editorial-category-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.category_size }}px * 0.8);
    }

    .ai-editorial-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-editorial-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
    }

    .ai-editorial-text-only-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-item-{{ ai_gen_id }}--large,
    .ai-editorial-item-{{ ai_gen_id }}--medium,
    .ai-editorial-item-{{ ai_gen_id }}--small {
      grid-column: span 6;
    }
  }
{% endstyle %}

